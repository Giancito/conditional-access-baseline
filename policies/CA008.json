{
  "displayName": "CA008 - Aplicaciones moviles - Requerir App Protection Policy - Para usuarios moviles",
  "description": "Requiere App Protection Policy para dispositivos moviles iOS y Android no administrados.",
  "state": "disabled",
  "conditions": {
    "users": {
      "includeUsers": [
        "All"
      ],
      "excludeGroups": [
        "__GRP_CA_EXC_EMERGENCIA_ID__",
        "__GRP_CA_EXC_SERVICIOS_ID__"
      ]
    },
    "applications": {
      "includeApplications": [
        "Office365"
      ]
    },
    "platforms": {
      "includePlatforms": [
        "iOS",
        "android"
      ]
    },
    "devices": {
      "deviceFilter": {
        "mode": "exclude",
        "rule": "device.isCompliant -eq True -or device.deviceOwnership -eq \"Company\""
      }
    }
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": [
      "compliantApplication"
    ]
  }
}